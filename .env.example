PUBLIC_BASE_URL=https://localhost:8443
DATABASE_URLS=sqlite:///./url_shortener_shard_0.db
DATABASE_REPLICA_URLS=
REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=change-me
POOL_MIN_AVAILABLE_CODES=1000000
POOL_LOW_WATERMARK_CODES=500000
POOL_SEED_BATCH_SIZE=50000
POOL_REFILL_CHECK_INTERVAL=100
ANONYMOUS_RATE_LIMIT_PER_MINUTE=60
REDIRECT_RATE_LIMIT_PER_MINUTE=300
RUN_ANALYTICS_WORKER_IN_API=true
ANALYTICS_QUEUE_NAME=analytics:redirect-events

# Real OAuth providers
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_CLIENT_ID=

YANDEX_OAUTH_CLIENT_SECRET=

VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=

# VK URLs depend on the app settings in VK ID.
VK_OAUTH_AUTHORIZE_URL=
VK_OAUTH_TOKEN_URL=
VK_OAUTH_USERINFO_URL=
